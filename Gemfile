source "https://rubygems.org"

# Matches the environment GitHub Pages builds with, so local and live agree.
# Do not replace this with a bare `gem "jekyll"` — Pages ignores it and builds
# with its own pinned versions, which is how "works locally, breaks live"
# starts. github-pages already brings jekyll-seo-tag and jekyll-sitemap, so
# they are not listed separately.
gem "github-pages", group: :jekyll_plugins

# Ruby 3 dropped webrick from the standard library; jekyll serve needs it.
gem "webrick"
