---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
{%- comment -%}
  The writing feed, written by hand rather than by jekyll-feed, because
  the writing lives in the `articles` collection instead of `_posts` and
  this way there is exactly one feed, at the conventional path.
{%- endcomment -%}
{%- assign articles = site.articles | sort: "date" | reverse -%}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | strip_newlines | strip | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/' | absolute_url }}</id>
  <updated>{% if articles.first %}{{ articles.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
    <uri>{{ '/about/' | absolute_url }}</uri>
  </author>
  <rights>{{ site.disclaimer | xml_escape }}</rights>

  {%- for a in articles %}
  <entry>
    <title>{{ a.title | xml_escape }}</title>
    <link href="{{ a.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ a.url | absolute_url }}</id>
    <published>{{ a.date | date_to_xmlschema }}</published>
    <updated>{{ a.date | date_to_xmlschema }}</updated>
    <summary>{{ a.description | strip_newlines | strip | xml_escape }}</summary>
    {%- if a.series %}
    <category term="{{ a.series | xml_escape }}"/>
    {%- endif %}
    {%- for t in a.tags %}
    <category term="{{ t | xml_escape }}"/>
    {%- endfor %}
  </entry>
  {%- endfor %}
</feed>
